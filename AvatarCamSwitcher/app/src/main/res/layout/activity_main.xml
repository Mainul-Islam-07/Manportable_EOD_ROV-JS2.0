<?xml version="1.0" encoding="utf-8"?>
<!--
  Avatar HUD. Full-screen camera feed with a transparent 3D-twin overlay and a
  control layer. Layout follows Final App.drawio.png:
    top-left   : REC oval, SOUND dropdown, FIRING/AIM button
    top-right  : battery chip, then the 3D FIGURE panel
    bottom-left: CAMERA dropdown + ZOOM dropdown
    bottom-right: gimbal D-pad (MAIN only) + 3D toggle
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen hardware video surface. -->
    <com.alexvas.rtsp.widget.RtspSurfaceView
        android:id="@+id/rtsp_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Black transition cover: masks the cross-feed/mosaic during a switch. -->
    <View
        android:id="@+id/transition_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3D FIGURE panel (top-right). The transparent OrbitGLSurfaceView is added
         into this container in code; it composites over the camera feed. -->
    <FrameLayout
        android:id="@+id/twin_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintHeight_percent="0.5" />

    <!-- Main-pack battery charge chip, in the top row right of the arm/disarm
         (SBUS mode) chip. Tint is driven in code (red under 15%). -->
    <TextView
        android:id="@+id/txt_battery"
        style="@style/HudChip"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_battery_chip"
        android:backgroundTint="#9E9E9E"
        android:fontFamily="monospace"
        tools:text="44%"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintStart_toEndOf="@id/txt_mode" />

    <!-- REC oval toggle (top-left). Grey = idle ("REC"), red = recording
         ("REC MM:SS"); tint + text are driven in onRecordingStateChanged. -->
    <Button
        android:id="@+id/btn_record"
        style="@style/HudChip"
        android:layout_margin="12dp"
        android:text="REC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- SOUND master on/off (top-left, right of REC). Grey "SOUND" = off,
         green "SOUND ON" = on. When on, the hold-to-talk button appears bottom-left. -->
    <Button
        android:id="@+id/btn_sound"
        style="@style/HudChip"
        android:layout_marginStart="8dp"
        android:text="SOUND"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintStart_toEndOf="@id/btn_record" />

    <!-- FIRING / AIM button (top-center). Direct press → 60 s hidden countdown
         (red) → AIM. Color/label/state driven in code. -->
    <Button
        android:id="@+id/btn_fire"
        style="@style/HudChip"
        android:layout_marginStart="8dp"
        android:text="FIRING"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintStart_toEndOf="@id/btn_sound" />

    <!-- SBUS mode (right of FIRING): DISARM/HOME/ARM/DRIVE from the Pi's
         sbus_mode_udp_bridge on UDP :9871. Text + tint driven in code; "—" when
         no feed. -->
    <TextView
        android:id="@+id/txt_mode"
        style="@style/HudInfo"
        android:layout_marginStart="8dp"
        android:minWidth="60dp"
        android:background="@drawable/bg_record_pill"
        android:backgroundTint="#9E9E9E"
        android:text="—"
        tools:text="DRIVE"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintStart_toEndOf="@id/btn_fire" />

    <!-- CAMERA dropdown (bottom-left): MAIN / FRONT / BACK / WRIST / GRIP.
         Size + font match REC; grey background; bottom-aligned to the 3D button. -->
    <Button
        android:id="@+id/btn_camera"
        style="@style/HudChip"
        android:layout_marginStart="12dp"
        android:text="MAIN CAM"
        app:layout_constraintBottom_toBottomOf="@id/btn_3d"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ZOOM dropdown (bottom-left, right of CAMERA): 4X / 3X / 2X / 1X.
         Shown only on the MAIN feed. Matches REC / CAMERA. -->
    <Button
        android:id="@+id/btn_zoom"
        style="@style/HudChip"
        android:layout_marginStart="8dp"
        android:text="1X"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/btn_3d"
        app:layout_constraintStart_toEndOf="@id/btn_camera" />

    <!-- Hold-to-talk (bottom-left, above CAMERA). Press and hold = TALK
         (mic -> Pi speaker); release = back to LISTEN. Red while held. Shown
         only while sound is on (toggled in code). -->
    <Button
        android:id="@+id/btn_talk"
        style="@style/HudChip"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:text="TALK"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_camera" />

    <!-- 3D overlay toggle (bottom-right corner). Size + font match REC. The bottom
         margin lifts the whole bottom control cluster (camera/zoom/talk/gimbal all
         chain off this button) up from the edge. -->
    <Button
        android:id="@+id/btn_3d"
        style="@style/HudChip"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="28dp"
        android:text="3D"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Info: opens the SIYI MK32 manual (dialog_help.xml). Left of the 3D toggle. -->
    <Button
        android:id="@+id/btn_help"
        style="@style/HudChip"
        android:layout_marginEnd="8dp"
        android:text="Info"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_3d"
        app:layout_constraintEnd_toStartOf="@id/btn_3d" />

    <!-- SIYI gimbal pan/tilt D-pad (bottom-right, above the 3D toggle; MAIN only).
         Hold an arrow to move, release to stop; center recenters. A8 mini at
         192.168.144.25:37260. -->
    <LinearLayout
        android:id="@+id/gimbal_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/btn_3d"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btn_tilt_up" style="@style/GimbalButton" android:text="▲" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btn_pan_left"      style="@style/GimbalButton" android:text="◀" />
            <Button android:id="@+id/btn_gimbal_center" style="@style/GimbalButton" android:text="⌂" />
            <Button android:id="@+id/btn_pan_right"     style="@style/GimbalButton" android:text="▶" />
        </LinearLayout>

        <Button android:id="@+id/btn_tilt_down" style="@style/GimbalButton" android:text="▼" />
    </LinearLayout>

    <!-- Persistent "reconnecting" indicator, centred over the black transition
         cover. Shown by enterReconnecting() while a feed is failing / has not
         delivered a first frame; hidden on onRtspFirstFrameRendered. Declared last
         so it draws above the cover. -->
    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_record_pill"
        android:backgroundTint="#CC000000"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="RECONNECTING FRONT…"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
