<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Active feed: highlighted green so the operator can see the live source. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/active_green" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/active_green_stroke" />
        </shape>
    </item>

    <!-- Pressed feedback. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/idle_stroke" />
        </shape>
    </item>

    <!-- Idle. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/idle_fill" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/idle_stroke" />
        </shape>
    </item>
</selector>
