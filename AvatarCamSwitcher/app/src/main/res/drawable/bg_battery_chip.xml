<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral rounded pill for the battery chip. Solid white base so an
     android:backgroundTint set in code recolours it cleanly: grey normally,
     red when the charge drops under 15%. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="14dp" />
</shape>
