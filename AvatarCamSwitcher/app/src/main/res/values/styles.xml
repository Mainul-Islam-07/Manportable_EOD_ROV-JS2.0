<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Equal-weight feed button used in the bottom nav bar. -->
    <style name="CamButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/btn_cam_selector</item>
        <!-- Drop the elevation animator so the flat overlay look stays consistent. -->
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Square digital-zoom button used in the right-side zoom column (MAIN only). -->
    <style name="ZoomButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginVertical">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/btn_zoom_selector</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Square gimbal pan/tilt key used in the right-side D-pad (MAIN only).
         Smaller than the original (28dp) to fit the repositioned HUD corner. -->
    <style name="GimbalButton">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_gimbal_key</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Collapsed tap-to-expand dropdown button (CAMERA / ZOOM / SOUND) and the
         FIRING/AIM and 3D toggle chips. The expanded list is built in code by
         HudDropdown; this is just the resting chip. -->
    <!-- Single source of truth for HUD chip size so REC / SOUND / FIRING / MAIN /
         1X / 3D / TALK all share one small, uniform look. Width flexes to the
         label above a common 60dp floor (so "SOUND ON" / "REC 00:00" never clip),
         but text size, height and padding are identical across every chip. Do NOT
         re-override these in the layout — that is what made the buttons uneven. -->
    <style name="HudChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">60dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/bg_record_pill</item>
        <item name="android:backgroundTint">#9E9E9E</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Info readout (battery / SBUS mode). Matches the chip height,
         text size and padding so the whole HUD row lines up; background + tint are
         set per-view since these carry their own state colours. -->
    <style name="HudInfo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
