[Unit]
Description=Robot software stack startup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jontro_soinik_2_0-2
# Ensure the user's environment (DISPLAY, ROS paths via the script) is sane
Environment=HOME=/home/jontro_soinik_2_0-2
WorkingDirectory=/home/jontro_soinik_2_0-2

ExecStart=/home/jontro_soinik_2_0-2/ros2_ws/src/necessary_codes/robot_startup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-startup

# Restart the whole stack if it dies; tune as needed
Restart=on-failure
RestartSec=10
TimeoutStartSec=0
KillMode=mixed

[Install]
WantedBy=multi-user.target
